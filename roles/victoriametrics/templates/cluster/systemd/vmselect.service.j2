{{ ansible_managed | comment }}

[Unit]
Description=Description=VictoriaMetrics vmselect service
After=network.target

[Service]
Type=simple
LimitNOFILE=2097152
UMask=0077
User={{ victoriametrics_user }}
Group={{ victoriametrics_group }}
ExecStart={{ victoriametrics_base_path }}/bin/vmselect-prod \
          -replicationFactor={{ victoriametrics_cluster_storage_nodes | length }} \
          -selectNode={{ victoriametrics_cluster_select_nodes | join(',') }} \
          -storageNode={{ victoriametrics_cluster_storage_nodes | join(',') }} \
          -search.maxUniqueTimeseries={{ victoriametrics_search_max_unique_ts }} \
          {{ victoriametrics_extra_configs | join(' ') }}
SyslogIdentifier=victoriametrics
Restart=always

PrivateTmp=yes
ProtectHome=yes
PrivateUsers=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
NoNewPrivileges=yes
LockPersonality=yes

ProtectSystem=full

[Install]
WantedBy=multi-user.target
